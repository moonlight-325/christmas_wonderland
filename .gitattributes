# Normalize text files in Git; preserve binary assets as-is.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.bat text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.webp binary
